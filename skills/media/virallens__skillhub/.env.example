# ViralLens 爆款视频分析 — Pay Skill 配置示例
# 复制为 .env 并填入真实值

# 模式: mock (本地测试) / live (生产)
SKILLPAY_MODE=mock

# DashScope API
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 服务地址
BASE_URL=https://meihua.astrakairos.com/virallens

# 微信支付配置
MCH_ID=
APP_ID=
MCH_SERIAL=
MCH_APIV3_KEY=
MCH_PRIVATE_KEY_PATH=/opt/virallens/key/apiclient_key.pem

# SkillHub 配置
SKILLHUB_DEVELOPER_ID=sh-XXXXXXXX
SKILLHUB_PUB_KEY_ID=PUB_KEY_XXXX
SKILLHUB_PRIVATE_KEY_PATH=/opt/virallens/key/private_key.pem
