# wechat-mp-suite 凭证配置 (v1.0.2)
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# 微信公众号 API 凭证（发布模块必需）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 搜狗微信搜索 Cookie（搜索模块必需）
# 获取: 浏览器打开 weixin.sogou.com → F12 → Network → 复制 Cookie
SOGOU_COOKIE=

# 远程 MCP 发布服务器（可选）
MCP_SERVER_URL=

# 网络代理（可选）
HTTP_PROXY=
HTTPS_PROXY=

# 调试模式
DEBUG=false
