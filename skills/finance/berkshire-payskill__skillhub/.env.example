# 支付模式：mock / live
SKILLPAY_MODE=mock

# 服务地址
BASE_URL=https://virallens.astrakairos.com/berkshire

# DashScope API
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 微信支付配置
WECHAT_MCH_ID=your_mch_id_here
WECHAT_MCH_CERT_SERIAL=your_cert_serial_here
WECHAT_MCH_API_V3_KEY=your_api_v3_key_here
WECHAT_APP_ID=your_app_id_here
WECHAT_MCH_PRIVATE_KEY_PATH=/path/to/wechat_private_key.pem

# SkillHub 配置
SKILLHUB_DEVELOPER_ID=your_developer_id_here
SKILLHUB_PUB_KEY_ID=your_pub_key_id_here
SKILLHUB_PRIVATE_KEY_PATH=/path/to/skillhub_private_key.pem
