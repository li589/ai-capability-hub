{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "营销宣传消保审查意见书输入",
  "type": "object",
  "required": ["meta", "problems"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["material"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["draft", "archive"],
          "default": "draft"
        },
        "material": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "product": { "type": "string" },
        "department": { "type": "string" },
        "submitter": { "type": "string" },
        "date": { "type": "string" },
        "conclusion": { "type": "string" },
        "riskLevel": { "$ref": "#/$defs/riskLevel" },
        "docNo": { "type": "string" },
        "source": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "archive" } },
            "required": ["mode"]
          },
          "then": {
            "required": ["docNo", "date", "department", "submitter", "conclusion", "riskLevel"]
          }
        }
      ]
    },
    "summary": { "type": "object" },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["no", "title", "risk", "dimension", "excerpt", "rule", "basis", "suggestion"],
        "properties": {
          "no": { "type": ["integer", "string"] },
          "title": { "type": "string", "minLength": 1 },
          "risk": { "$ref": "#/$defs/riskLevel" },
          "dimension": { "$ref": "#/$defs/dimension" },
          "excerpt": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "basis": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "suggestion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evaluation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dim": { "$ref": "#/$defs/dimension" },
          "score": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "evaluationSummary": { "type": "string" },
    "remediation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["no", "item", "level"],
        "properties": {
          "no": { "type": ["integer", "string"] },
          "item": { "type": "string", "minLength": 1 },
          "level": { "$ref": "#/$defs/riskLevel" },
          "deadline": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    },
    "approvals": { "type": "array" }
  },
  "$defs": {
    "riskLevel": {
      "type": "string",
      "enum": ["🔴 高风险", "🟡 中风险", "🟢 低风险"]
    },
    "dimension": {
      "type": "string",
      "enum": ["合法合规", "真实准确", "风险提示", "信息完整", "公平诚信", "个人信息保护"]
    }
  }
}
