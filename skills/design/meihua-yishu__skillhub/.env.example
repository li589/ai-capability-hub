# 梅花易数 Pay Skill 环境变量模板
# 运行模式: live=真实收款(默认) / mock=本地测试
SKILLPAY_MODE=live
# 定价（分）: 199 = ¥1.99
PRICE=199
# 对外公网地址
BASE_URL=https://meihua.astrakairos.com
# DashScope LLM（premium 档 AI 深度解读，缺失时回退模板）
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
# 微信支付商户凭证
MCH_ID=
MCH_SERIAL=
APP_ID=
MCH_APIV3_KEY=
MCH_PRIVATE_KEY_PATH=/opt/workbuddy/key/apiclient_key.pem
# SkillHub 开发者密钥
SKILLHUB_DEVELOPER_ID=
SKILLHUB_PUB_KEY_ID=
SKILLHUB_PRIVATE_KEY_PATH=/opt/workbuddy/key/private_key.pem
