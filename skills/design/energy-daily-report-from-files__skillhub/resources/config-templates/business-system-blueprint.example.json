        "read",
        "create",
        "update"
      ]
    },
    {
      "key": "energy_anomaly_manage",
      "entity": "energy_anomaly",
      "actions": [
        "read",
        "create",
        "update",
        "transition"
      ]
    }
  ],
  "role_permissions": {
    "administrator": [
      "*"
    ],
    "energy_manager": [
      "energy_daily_read",
      "energy_daily_write",
      "energy_daily_approve",
      "energy_meter_manage",
      "energy_target_manage",
      "energy_anomaly_manage"
    ],
    "factory_operator": [
      "energy_daily_read",
      "energy_daily_write",
      "energy_anomaly_manage"
    ],
    "viewer": [
      "energy_daily_read"
    ]
  },
  "workflows": [
    {
      "key": "energy_daily_approval",
      "entity": "energy_daily_report",
      "state_field": "status",
      "states": [
        "draft",
        "submitted",
        "approved",
        "returned"
      ],
      "transitions": [
        {
          "key": "submit",
          "from": "draft",
          "to": "submitted",
          "permission": "energy_daily_write"
        },
        {
          "key": "approve",
          "from": "submitted",
          "to": "approved",
          "permission": "energy_daily_approve",
          "requires_comment": true
        },
        {
          "key": "return",
          "from": "submitted",
          "to": "returned",
          "permission": "energy_daily_approve",
          "requires_comment": true
        },
        {
          "key": "resubmit",
          "from": "returned",
          "to": "submitted",
          "permission": "energy_daily_write"
        }
      ],
      "approval_steps": [
        {
          "order": 1,
          "role": "energy_manager",
          "display_name": "能源主管审批"
        }
      ]
    },
    {
      "key": "energy_anomaly_close",
      "entity": "energy_anomaly",
      "state_field": "status",
      "states": [
        "open",
        "assigned",
        "in_progress",
        "verified",
        "closed"
      ],
      "transitions": [
        {
          "key": "assign",
          "from": "open",
          "to": "assigned",
          "permission": "energy_anomaly_manage"
        },
        {
          "key": "start",
          "from": "assigned",
          "to": "in_progress",
          "permission": "energy_anomaly_manage"
        },
        {
          "key": "verify",
          "from": "in_progress",
          "to": "verified",
          "permission": "energy_anomaly_manage",
          "requires_comment": true
        },
        {
          "key": "close",
          "from": "verified",
          "to": "closed",
          "permission": "energy_anomaly_manage",
          "requires_comment": true
        }
      ]
    }
  ],
  "metrics": [
    {
      "key": "total_energy_consumption",
      "display_name": "能源总消耗",
      "entity": "energy_daily_report",
      "formula": "sum(consumption)",
      "unit": "按能源类型展示",
      "version": "1.7.0"
    },
    {
      "key": "unit_energy_consumption",
      "display_name": "综合单耗",
      "entity": "energy_daily_report",
      "formula": "sum(consumption) / sum(output_qty)",
      "unit": "按能源类型/产量单位",
      "zero_denominator": "show_dash",
      "version": "1.7.0"
    },
    {
      "key": "energy_cost",
      "display_name": "能源成本",
      "entity": "energy_daily_report",
      "formula": "sum(cost)",
      "unit": "元",
      "version": "1.7.0"
    },
    {
      "key": "open_anomaly_count",
      "display_name": "未关闭能耗异常",
      "entity": "energy_anomaly",
      "formula": "count(status in ['open','assigned','in_progress','verified'])",
      "unit": "项",
      "version": "1.7.0"
    }
  ],
