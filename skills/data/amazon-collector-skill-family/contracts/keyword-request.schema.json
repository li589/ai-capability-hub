{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amazon-collector/keyword-request/1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["keyword", "quantity", "site"],
  "properties": {
    "keyword": {"type": "string", "minLength": 1},
    "quantity": {"type": "integer", "minimum": 1, "maximum": 1000},
    "site": {"type": "string", "minLength": 2, "maxLength": 32},
    "review_limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 100},
    "review_start_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
