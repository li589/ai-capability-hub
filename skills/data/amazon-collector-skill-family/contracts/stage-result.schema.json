{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amazon-collector/stage-result/1.0",
  "type": "object",
  "required": ["contract_version", "stage", "status", "warnings", "errors"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "stage": {"enum": ["list", "details", "reviews", "export", "orchestrator"]},
    "status": {"enum": ["LIST_EXPORTED", "DETAILS_EXPORTED", "REVIEWS_EXPORTED", "CSV_READY", "COMPLETE", "PARTIAL", "FAILED"]},
    "run_dir": {"type": "string", "minLength": 1},
    "template": {"type": "object"},
    "task": {"type": "object"},
    "tasks": {"type": "array", "items": {"type": "object"}},
    "records_path": {"type": "string"},
    "files": {"type": "object", "additionalProperties": {"type": "string"}},
    "row_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
